generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  MEDICAMENT
  OTC
  SUPPLEMENT
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String       @default("")
  lastName     String       @default("")
  role         Role         @default(ADMIN)
  invitations  Invitation[]
  createdAt    DateTime     @default(now())
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role
  // Seul le hash du jeton est stocké : le lien envoyé par mail ne se retrouve pas en base.
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Ligne unique (id = 1) : réglages globaux du site.
model SiteSettings {
  id                 Int     @id @default(1)
  maintenance        Boolean @default(false)
  maintenanceMessage String?
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  category        ProductCategory
  principeActif   String
  dosages         String[]
  forme           String
  conditionnement String
  classe          String
  indications     String
  flavor          String?
  imageUrl        String
  notices         Notice[]
  variants        ProductVariant[]
  published       Boolean         @default(true)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  dosage    String
  imageUrl  String
  position  Int     @default(0)

  @@unique([productId, dosage])
}

model Notice {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  url       String
  position  Int     @default(0)

  @@index([productId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Vue de page publique, enregistrée par /api/track (sans cookie ni IP en clair).
model PageView {
  id          String   @id @default(cuid())
  // Jour UTC (AAAA-MM-JJ) : sert au regroupement et au hash visiteur, qui change chaque jour.
  day         String
  path        String
  referrer    String   @default("")
  deviceType  String   @default("desktop")
  country     String   @default("")
  // Temps passé sur la page en millisecondes, envoyé à la sortie de la page.
  duration    Int?
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([day])
  @@index([day, path])
}
